# Copy to .env and fill in before deploying.
# Anything prefixed VITE_ is baked into the browser bundle at build time,
# so never put a secret behind that prefix.

# ---------------------------------------------------------------- web

# Your real domain. Used for canonical URLs, hreflang alternates, Open
# Graph URLs and the generated sitemap. No trailing slash.
VITE_SITE_URL=https://orbis.example

# Where the storefront looks for the API.
#   unset          -> runs standalone against the in-browser mock
#                     catalogue, no backend required
#   /api           -> same origin (the dev and preview servers proxy
#                     this to the API; `npm run dev:all` sets it for you)
#   https://api... -> a separate host, which must list your storefront
#                     origin in CORS_ORIGINS below
# VITE_API_URL=/api

# Optional. An endpoint returning {"country":"AE"} from whatever geo
# header your CDN already sets. The API serves exactly this at /api/geo.
# Leave unset and the app falls back to the browser's timezone and
# languages, which needs no server and no third-party lookup.
# VITE_GEO_ENDPOINT=/api/geo

# ---------------------------------------------------------------- api

# Port the API listens on (default 8787).
# PORT=8787

# ------------------------------------------------------------ database

# REQUIRED. The API does nothing without it.
#
# MongoDB Atlas free tier is enough. Create a cluster, then:
#   Database Access -> add a user, copy its password
#   Network Access  -> allow 0.0.0.0/0
#
# That last one is not laziness: serverless functions get a different
# outbound IP on every cold start, so there is no address to allow-list.
# The database is still protected by the user, the password and TLS.
#
# Copy the "Drivers" connection string and paste the password in:
# MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
#
# If the password contains @ : / ? # [ ] % it must be percent-encoded,
# or the URI will not parse.

# For local work you can skip Atlas entirely:
#   npm run db:dev    starts a throwaway MongoDB and prints its URI
#
# Which database inside the cluster (default "orbis"). Handy for keeping
# a staging deployment away from live orders.
# MONGODB_DB=orbis

# Browser origins allowed to call the API, comma separated. Required in
# production; in development any localhost port is accepted.
# CORS_ORIGINS=https://orbis.example,https://www.orbis.example

# Set NODE_ENV=production to enforce CORS_ORIGINS strictly.
# NODE_ENV=production

# Number of proxy hops in front of the API (nginx, a load balancer, a
# CDN). Without it every customer shares the proxy's IP and the rate
# limiter throttles them as one. Do NOT set it when there is no proxy —
# a client could then forge X-Forwarded-For and walk past the limiter.
# TRUST_PROXY=1

# Orders allowed per IP per hour (default 30), and an escape hatch for
# test runs.
# ORDER_RATE_LIMIT=30
# RATE_LIMIT=off

# ------------------------------------------------------------- admin

# The dashboard at /admin is OFF until one of these is set. A deployment
# that forgets is locked, not wide open.
#
# Generate the hash (preferred — the plaintext then lives nowhere):
#   npm run admin:hash -- "a long passphrase"
# ADMIN_PASSWORD_HASH=scrypt:...:...
#
# Or the plain password, if you would rather:
# ADMIN_PASSWORD=a-long-passphrase

# Optional: signs the session tokens. Defaults to the password, which is
# fine — set it only if you want changing the password to leave existing
# sessions valid, or the reverse.
# ADMIN_SECRET=some-other-long-random-string
