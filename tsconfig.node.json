{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "types": ["node"],
    // Composite projects must emit, but nothing here is meant to ship —
    // Vite compiles the real config itself. Park the output out of the way.
    "outDir": "./node_modules/.tmp/tsconfig-node",
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig-node.tsbuildinfo"
  },
  "include": ["vite.config.ts", "src/api/db.ts", "src/regions/config.ts", "src/types.ts"]
}
