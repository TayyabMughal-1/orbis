# server/ is NOT ignored: api/[...slug].ts imports the Express app out of
# server/src/app.ts, so the whole API is bundled into the serverless
# function. Excluding it would break the build.

# Local-only
.env
*.local

# The SQLite era left a data directory behind on some machines; it is
# never used now and must not be uploaded.
server/data
server/dist
